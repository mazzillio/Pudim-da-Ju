NODE_ENV=development
HOST=0.0.0.0
PORT=3333

DATABASE_URL=postgres://pudim:pudim@localhost:5432/pudim_da_ju

# Use a long random string in production (openssl rand -hex 32)
JWT_SECRET=troque-este-segredo-por-uma-string-bem-longa-e-aleatoria
JWT_EXPIRES_IN=1d

# Comma-separated allowed origins: storefront (Web) and admin panel (Admin)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Cloudflare R2 (product photos) — contract only for now; POST /uploads/product-image answers 501
# until the storage is implemented. Planned variables:
# CLOUDFLARE_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=pudim-da-ju
# R2_PUBLIC_URL=https://pub-xxxx.r2.dev
# UPLOAD_URL_EXPIRES_SECONDS=300

# Store owner account created by `npm run db:seed`
ADMIN_NAME=Ju
ADMIN_EMAIL=ju@pudimdaju.com.br
ADMIN_PASSWORD=troque-esta-senha
