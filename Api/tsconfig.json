{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    // Explicit so configs that extend this one from elsewhere (Vercel writes one in /tmp) still find @types/node.
    "typeRoots": ["./node_modules/@types"],
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["index.ts", "src", "test", "drizzle.config.ts", "vitest.config.ts"]
}
