# Pudim da Ju API (../Api). Add this panel's origin (http://localhost:5173) to the API's CORS_ORIGIN.
VITE_API_URL=http://localhost:3333

# Storefront URL, used by the "Ver loja" button.
VITE_STORE_URL=http://localhost:3000

